{
  "id": "e4dbc5d1-9024-4c60-a2a6-a44852cd4062",
  "name": "Order Confirmation Flow",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order-confirmation",
        "options": {}
      },
      "id": "wh1",
      "name": "Order Placed Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "order-confirmation-wh"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_SERVER_URL }}/initiate-call",
        "sendBody": true,
        "bodyContentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"orderId\": \"{{ $json.body.orderId }}\",\n  \"customerName\": \"{{ $json.body.customerName }}\",\n  \"customerPhone\": \"{{ $json.body.customerPhone }}\",\n  \"address\": \"{{ $json.body.address }}\",\n  \"total\": {{ $json.body.total }},\n  \"items\": {{ JSON.stringify($json.body.items) }},\n  \"callbackUrl\": \"{{ $resumeWebhookUrl }}\"\n}",
        "options": {}
      },
      "id": "hr1",
      "name": "Trigger AI Agent Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "wait1",
      "name": "Wait for Call Result",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [720, 300],
      "webhookId": "call-result-wh"
    },
    {
      "id": "if1",
      "name": "Was Order Confirmed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.confirmed }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "hr2",
      "name": "Mark Order CONFIRMED",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 180],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.NEXTJS_URL }}/api/orders/{{ $json.body.orderId }}",
        "sendBody": true,
        "bodyContentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\n  \"status\": \"CONFIRMED\",\n  \"callStatus\": \"CONFIRMED_BY_CALL\"\n}",
        "options": {}
      }
    },
    {
      "id": "hr3",
      "name": "Mark Order CANCELLED",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 420],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.NEXTJS_URL }}/api/orders/{{ $json.body.orderId }}",
        "sendBody": true,
        "bodyContentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\n  \"status\": \"CANCELLED\",\n  \"callStatus\": \"CANCELLED_BY_CALL\"\n}",
        "options": {}
      }
    },
    {
      "id": "set1",
      "name": "Format Sheet Row",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [480, 480],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "orderId", "value": "={{ $json.body.orderId }}", "type": "string" },
            { "id": "a2", "name": "customerName", "value": "={{ $json.body.customerName }}", "type": "string" },
            { "id": "a3", "name": "customerPhone", "value": "={{ $json.body.customerPhone }}", "type": "string" },
            { "id": "a4", "name": "address", "value": "={{ $json.body.address }}", "type": "string" },
            { "id": "a5", "name": "total", "value": "={{ $json.body.total }}", "type": "number" },
            { "id": "a6", "name": "placedAt", "value": "={{ $now.toISO() }}", "type": "string" },
            { "id": "a7", "name": "status", "value": "PENDING", "type": "string" },
            { "id": "a8", "name": "confirmedAt", "value": "", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "sheets1",
      "name": "Log Order to Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [720, 480],
      "onError": "continueRegularOutput",
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "352496e9-9555-4353-aa1c-867e1eed2c6a", "name": "Google Sheets account" }
      },
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "1H6tFQOhXjqMcJJdzFViN2dKWWO5nbQsbi7tsvxlMBCY"
        },
        "sheetName": {
          "__rl": true,
          "mode": "id",
          "value": "0"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      }
    },
    {
      "id": "cal1",
      "name": "Create Delivery Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [1440, 180],
      "onError": "continueRegularOutput",
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "72292780-02f3-4e43-ae30-971057326b8b", "name": "Google Calendar account" }
      },
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "fixibot038@gmail.com"
        },
        "start": "={{ $now }}",
        "end": "={{ $now.plus(1, 'hour') }}",
        "useDefaultReminders": true,
        "additionalFields": {
          "summary": "=Deliver order for {{ $('Wait for Call Result').first().json.body.customerName }}",
          "description": "=Order {{ $('Wait for Call Result').first().json.body.orderId }}, confirmed by NexusBarry call.\nAddress: {{ $('Wait for Call Result').first().json.body.address }}\nPhone: {{ $('Wait for Call Result').first().json.body.customerPhone }}\nTotal: ${{ $('Wait for Call Result').first().json.body.total }}"
        }
      }
    },
    {
      "id": "set2",
      "name": "Prepare Confirmed Row",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [1440, 400],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "b1", "name": "orderId", "value": "={{ $('Wait for Call Result').first().json.body.orderId }}", "type": "string" },
            { "id": "b2", "name": "status", "value": "CONFIRMED", "type": "string" },
            { "id": "b3", "name": "confirmedAt", "value": "={{ $now.toISO() }}", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "set3",
      "name": "Prepare Cancelled Row",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [1200, 560],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "orderId", "value": "={{ $('Wait for Call Result').first().json.body.orderId }}", "type": "string" },
            { "id": "c2", "name": "status", "value": "CANCELLED", "type": "string" },
            { "id": "c3", "name": "confirmedAt", "value": "={{ $now.toISO() }}", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "sheets2",
      "name": "Update Sheet Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [1680, 480],
      "onError": "continueRegularOutput",
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "352496e9-9555-4353-aa1c-867e1eed2c6a", "name": "Google Sheets account" }
      },
      "parameters": {
        "resource": "sheet",
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "1H6tFQOhXjqMcJJdzFViN2dKWWO5nbQsbi7tsvxlMBCY"
        },
        "sheetName": {
          "__rl": true,
          "mode": "id",
          "value": "0"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": ["orderId"],
          "value": {}
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Order Placed Webhook": {
      "main": [[
        { "node": "Trigger AI Agent Call", "type": "main", "index": 0 },
        { "node": "Format Sheet Row", "type": "main", "index": 0 }
      ]]
    },
    "Format Sheet Row": {
      "main": [[{ "node": "Log Order to Sheets", "type": "main", "index": 0 }]]
    },
    "Trigger AI Agent Call": {
      "main": [[{ "node": "Wait for Call Result", "type": "main", "index": 0 }]]
    },
    "Wait for Call Result": {
      "main": [[{ "node": "Was Order Confirmed?", "type": "main", "index": 0 }]]
    },
    "Was Order Confirmed?": {
      "main": [
        [{ "node": "Mark Order CONFIRMED", "type": "main", "index": 0 }],
        [{ "node": "Mark Order CANCELLED", "type": "main", "index": 0 }]
      ]
    },
    "Mark Order CONFIRMED": {
      "main": [[
        { "node": "Create Delivery Calendar Event", "type": "main", "index": 0 },
        { "node": "Prepare Confirmed Row", "type": "main", "index": 0 }
      ]]
    },
    "Mark Order CANCELLED": {
      "main": [[{ "node": "Prepare Cancelled Row", "type": "main", "index": 0 }]]
    },
    "Prepare Confirmed Row": {
      "main": [[{ "node": "Update Sheet Row", "type": "main", "index": 0 }]]
    },
    "Prepare Cancelled Row": {
      "main": [[{ "node": "Update Sheet Row", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
